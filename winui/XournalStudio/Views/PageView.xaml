<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XournalStudio.Views.PageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Sheet" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0.5">
        <Image x:Name="PdfImage" Stretch="Fill" />
        <Path x:Name="Pattern" StrokeThickness="0.5" />
        <InkCanvas x:Name="Canvas" />
    </Grid>
</UserControl>
