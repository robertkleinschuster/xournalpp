<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XournalStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Xournal Studio">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Datei">
                <MenuFlyoutItem Text="Neu" Click="OnNew">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Page2" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Ã–ffnenâ€¦" Click="OnOpen">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="OpenFile" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Speichern" Click="OnSave">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Save" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Speichern unterâ€¦" Click="OnSaveAs">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Bearbeiten">
                <MenuFlyoutItem x:Name="UndoMenuItem" Text="RÃ¼ckgÃ¤ngig" Click="OnUndo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RedoMenuItem" Text="Wiederholen" Click="OnRedo">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Redo" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Seite">
                <MenuFlyoutItem Text="Seite einfÃ¼gen" Click="OnInsertPage">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Seite lÃ¶schen" Click="OnDeletePage">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Ansicht">
                <MenuFlyoutItem Text="Seitenbreite" Click="OnFitWidth">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="VergrÃ¶ÃŸern" Click="OnZoomIn">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="ZoomIn" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Add" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Verkleinern" Click="OnZoomOut">
                    <MenuFlyoutItem.Icon><SymbolIcon Symbol="ZoomOut" /></MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <!-- Single toolbar, everything left-aligned (nothing at the right edge). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="8,0,8,4">
            <InkToolbar x:Name="Toolbar" InitialControls="None" VerticalAlignment="Center">
                <InkToolbarBallpointPenButton x:Name="PenButton" />
                <InkToolbarHighlighterButton x:Name="HighlighterButton" />
                <InkToolbarEraserButton IsClearAllVisible="False" />
            </InkToolbar>
            <AppBarSeparator />
            <AppBarButton Icon="Add" LabelPosition="Collapsed" Label="Seite einfÃ¼gen"
                          ToolTipService.ToolTip="Seite einfÃ¼gen" Click="OnInsertPage" />
            <AppBarButton Icon="Delete" LabelPosition="Collapsed" Label="Seite lÃ¶schen"
                          ToolTipService.ToolTip="Seite lÃ¶schen" Click="OnDeletePage" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Icon="Undo" LabelPosition="Collapsed" Label="RÃ¼ckgÃ¤ngig"
                          ToolTipService.ToolTip="RÃ¼ckgÃ¤ngig" Click="OnUndo" IsEnabled="False" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" LabelPosition="Collapsed" Label="Wiederholen"
                          ToolTipService.ToolTip="Wiederholen" Click="OnRedo" IsEnabled="False" />
        </StackPanel>

        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ScrollView x:Name="Scroller" ZoomMode="Enabled" ContentOrientation="Vertical"
                        MinZoomFactor="0.2" MaxZoomFactor="6"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                        ViewChanged="OnViewChanged" SizeChanged="OnScrollerSizeChanged">
                <StackPanel x:Name="PagesPanel" Spacing="16" Padding="16" HorizontalAlignment="Center" />
            </ScrollView>
            <InfoBar x:Name="Info" VerticalAlignment="Top" Margin="16" IsOpen="False" />
        </Grid>
    </Grid>
</Window>
